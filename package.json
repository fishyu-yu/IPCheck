{
  "name": "netprobe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "build:edgeone": "pnpm build && node scripts/edgeone.mjs",
    "preview": "wrangler dev",
    "deploy:cloudflare": "pnpm build && wrangler deploy",
    "deploy:pages": "pnpm build && wrangler pages deploy dist",
    "test:e2e": "playwright test",
    "check:cloudflare": "wrangler deploy --dry-run --outdir artifacts/cloudflare",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "hono": "^4.10.0",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.45.0"
  }
}
