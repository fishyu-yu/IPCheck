# Server-only; never prefix secrets with VITE_. Local Vite dev reads .env.local.
IPINFO_TOKEN=
ABUSEIPDB_KEY=
IPQS_KEY=
GEO_FREE_PROVIDER=on
DOH_URLS=https://cloudflare-dns.com/dns-query,https://dns.google/resolve
ACTIVE_PROBES=on
ALLOWED_PORTS=80,443,22,25,53,110,143,465,587,993,995,3306,5432,6379
PROBE_URL=
PROBE_SECRET=
DNS_COLLECTOR_URL=
DNS_COLLECTOR_SECRET=
DNS_TEST_DOMAIN=
SITE_URL=https://your-domain.example
VITE_SITE_URL=https://your-domain.example
# Only local dev: supply a known public IP explicitly. It is not auto-detected.
DEV_PUBLIC_IP=
