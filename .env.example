# 服务端配置；密钥禁止使用 VITE_ 前缀。本地 Vite 从 .env.local 读取。
IPINFO_TOKEN=
ABUSEIPDB_KEY=
IPQS_KEY=
GEO_FREE_PROVIDER=on
DOH_URLS=https://cloudflare-dns.com/dns-query,https://dns.google/resolve
ACTIVE_PROBES=on
ALLOWED_PORTS=80,443,22,25,53,110,143,465,587,993,995,3306,5432,6379
PROBE_URL=
PROBE_SECRET=
DNS_COLLECTOR_URL=
DNS_COLLECTOR_SECRET=
DNS_TEST_DOMAIN=
SITE_URL=https://your-domain.example
VITE_SITE_URL=https://your-domain.example
# 仅本地开发：显式填写测试公网 IP，不代表自动检测到的访客地址。
DEV_PUBLIC_IP=

