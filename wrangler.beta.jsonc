{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "netprobe-beta",
  "main": "edge/cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "ipbeta.f1shyu.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "observability": { "enabled": false },
  "vars": {
    "GEO_FREE_PROVIDER": "on",
    "ACTIVE_PROBES": "on",
    "SITE_URL": "https://ipbeta.f1shyu.com",
  },
  "ratelimits": [
    { "name": "RATE_QUERY", "namespace_id": "2001", "simple": { "limit": 60, "period": 60 } },
    { "name": "RATE_PROBE", "namespace_id": "2002", "simple": { "limit": 10, "period": 60 } },
  ],
}
